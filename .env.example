# Telegram bot @RutaCriptoSeguraBot — template. Copy to .env.local for the local scripts, and create the
# SAME names in Vercel → Project → Settings → Environment Variables (Production). Real values never go to Git.
# None of these names starts with NEXT_PUBLIC_ on purpose: they must never reach the browser.
# Full guide (Russian): docs/TELEGRAM_BOT.md

# Token from BotFather. Server-only secret (in Vercel tick "Sensitive").
TELEGRAM_BOT_TOKEN=

# Random secret Telegram sends with every update (header X-Telegram-Bot-Api-Secret-Token).
# 16-256 characters from A-Z a-z 0-9 _ -  Generate one:  openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Upstash Redis (REST). Created for you by Vercel → Storage → Upstash → Redis, or at upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Telegram numeric ids of the people allowed to upload the PDF and read /estado, comma-separated.
# Write /id to the bot to learn yours. Leave empty on the very first deploy.
TELEGRAM_ADMIN_USER_IDS=

# --- optional ---------------------------------------------------------------------------------------
# The channel whose subscribers get the guide. Default: the channel the site links to (@rutacriptosegura).
# TELEGRAM_CHANNEL_CHAT_ID=@rutacriptosegura
# Emergency copy of the guide's Telegram file_id, used only if the stored one is lost.
# TELEGRAM_GUIDE_FILE_ID=
