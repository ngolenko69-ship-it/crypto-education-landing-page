# Telegram bot @RutaCriptoSeguraBot — template. Copy to .env.local for the local scripts, and create the
# SAME names in Vercel → Project → Settings → Environment Variables (Production). Real values never go to Git.
# None of these names starts with NEXT_PUBLIC_ on purpose: they must never reach the browser.
# Full guide (Russian): docs/TELEGRAM_BOT.md

# Token from BotFather. Server-only secret (in Vercel tick "Sensitive").
TELEGRAM_BOT_TOKEN=

# Random secret Telegram sends with every update (header X-Telegram-Bot-Api-Secret-Token).
# 16-256 characters from A-Z a-z 0-9 _ -  Generate one:  openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Upstash Redis (REST). Vercel → Storage → Upstash → Redis creates these two names for you (it also adds
# KV_REST_API_READ_ONLY_TOKEN, KV_URL and REDIS_URL — the bot does not read those: it needs the read-write token).
# A database created on upstash.com directly works too, under UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Telegram numeric ids of the people allowed to upload the PDF and read /estado, comma-separated.
# Write /id to the bot to learn yours. Leave empty on the very first deploy.
TELEGRAM_ADMIN_USER_IDS=

# --- optional ---------------------------------------------------------------------------------------
# The channel whose subscribers get the guide. Default: the official channel (@rutacriptosegura, see lib/bot/links.ts).
# TELEGRAM_CHANNEL_CHAT_ID=@rutacriptosegura
# Emergency copy of the guide's Telegram file_id, used only if the stored one is lost.
# TELEGRAM_GUIDE_FILE_ID=

# --- temporary setup page /telegram-setup (docs/TELEGRAM_BOT.md, section 7) ----------------------------------
# Off unless TELEGRAM_SETUP_ENABLED is exactly "true": otherwise the page and its route answer 404.
# Turn it on only while connecting the bot; afterwards delete both variables in Vercel and Redeploy.
# TELEGRAM_SETUP_ENABLED=true
# Your own key for that page: 24-128 visible characters, no spaces, different from every other secret above.
# TELEGRAM_SETUP_SECRET=

# --- Google Ads measurement (optional; PUBLIC values, unlike everything above) ------------------------------
# The Google tag ID (AW-18517392159) is a constant in lib/ads.ts. A Conversion Label comes from Google Ads →
# Goals → Conversions → your conversion action → Tag setup → event snippet: send_to: 'AW-18517392159/<LABEL>'.
# Put only the part AFTER the slash. These names start with NEXT_PUBLIC_ on purpose: the browser needs them, they
# are not secrets, and Next.js copies them into the build, so changing one needs a Redeploy. Set them for
# Production only (a Preview must not report conversions). Empty or missing = no conversion is sent for that
# action (the named ruta_*_click events are still sent, with consent). Guide: docs/GOOGLE_ADS.md
# Recommended roles in Google Ads (so the same person is not counted up to three times): COURSE = the
# Primary conversion to optimise for; COMMUNITY and MANAGER = Secondary (observation only). Count: One.
# NEXT_PUBLIC_GOOGLE_ADS_LABEL_COURSE=
# NEXT_PUBLIC_GOOGLE_ADS_LABEL_COMMUNITY=
# NEXT_PUBLIC_GOOGLE_ADS_LABEL_MANAGER=
